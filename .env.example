SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
WIKIMEDIA_BOT_USERNAME=
WIKIMEDIA_BOT_PASSWORD=

# Phase 2: source discovery + codegen (console API key, billed per-use --
# never a claude.ai/Claude Code subscription login, which Anthropic's terms
# prohibit third-party apps from offering)
ANTHROPIC_API_KEY=

# Phase 3: a Hugging Face access token (read access is enough) from an account
# that has accepted the DINOv3 terms -- the embed stage's default model is gated.
HF_TOKEN=

# Optional, for Task 8's finish/crash notifications -- either or both
DISCORD_WEBHOOK_URL=
NTFY_URL=

# Phase 2: per-source keys, only if a promoted source declares REQUIRES_API_KEY
# SOURCE_<NAME>_API_KEY=
